      "supported": true,
      "reason": "Fusion 360 runs on macOS; bridge + add-in install paths handled by fusion_detect.py."
    },
    "linux": {
      "supported": false,
      "reason": "Autodesk doesn't ship Fusion 360 for Linux, so there's no host app for the add-in to attach to."
